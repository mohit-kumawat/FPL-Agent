# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# --- Personal / private data: never publish -------------------------------
# Your squad, entry id and purchase prices. Start from squad.example.yaml.
squad.yaml

# Session cookie or any secret you add yourself
.env
.env.*

# Your own run history: reports, decisions, research notes, predictions
reports/
memory/state.json
memory/pending.json
memory/decisions.jsonl
memory/runs.jsonl
memory/predictions/
memory/research/
memory/calibration.jsonl
memory/signal_log.jsonl
memory/signal_scores.jsonl
memory/decision_scores.jsonl
memory/approvals.jsonl
memory/shadow_scores.jsonl
# The generated handoff: rewritten every run, carries decisions and rank
memory/digest.json
memory/current-context.md

# Scheduled-routine output: briefs, run logs, generated view
memory/briefs/
routine/logs/
routine/view.html
.routine.lock/

# Forward-test ledger: hash-sealed copies of YOUR recommendations (your squad)
eval/phase3-predictions.jsonl
# Regenerable backtest output (merge into agent-backtest-report.md by hand)
eval/agent-backtest-phase01.md

# Your research signals (may quote paywalled/personal sources)
signals/*.yaml
signals/*.yml
!signals/*.example.yaml
# Archived signals carry the same privacy — the globs above do not recurse
signals/archive/

# --- Caches: large, regenerable, and API-derived ---------------------------
data/snapshots/
data/history/
data/*.csv
data/*.parquet

# External provider payloads (shadow mode): third-party data, never publish
data/external/
